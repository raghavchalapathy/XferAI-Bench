<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:;">
<title>Xfer Benchmark report - {{ m.dataset_id }} - {{ m.stage }}</title>
<style>
:root{--bg:#1b1c22;--panel:#24252d;--panel2:#2c2d37;--line:#3a3b46;--text:#ecebf4;--muted:#b3b0c2;--violet:#a78bfa;--magenta:#f472d0;--ok:#86efac;--warn:#fcd34d;--bad:#fca5a5}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1180px;margin:0 auto;padding:16px}
header{border-bottom:2px solid var(--violet);padding:12px 0 16px;margin-bottom:16px}
h1{font-size:1.6rem;margin:0 0 4px}h1 span{color:var(--violet)}
h2{font-size:1.2rem;color:var(--violet);margin:28px 0 10px;border-left:4px solid var(--magenta);padding-left:10px}
h3{font-size:1rem;margin:16px 0 6px;color:var(--text)}
p,li{color:var(--text)}.muted{color:var(--muted)}
a{color:var(--violet)}a:focus,abbr:focus{outline:2px solid var(--magenta)}
.banner{background:#3b2350;border:1px solid var(--magenta);border-radius:8px;padding:10px 14px;margin:12px 0;font-weight:600}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.card .k{color:var(--muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.04em}
.card .v{font-size:1.25rem;font-weight:650}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:8px;margin:8px 0}
table{border-collapse:collapse;width:100%;font-size:.86rem}
th,td{padding:6px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
td.wide{min-width:18rem}
th{background:var(--panel2);color:var(--muted);font-weight:600;position:sticky;top:0}
td.n{text-align:right;font-variant-numeric:tabular-nums}
tr:hover td{background:#2a2b35}
.chart{width:100%;height:auto;background:var(--panel);border:1px solid var(--line);border-radius:8px;margin:6px 0}
.legend span{display:inline-block;margin-right:14px}.sw{display:inline-block;width:12px;height:12px;border-radius:2px;vertical-align:-1px;margin-right:4px}
.pill{display:inline-block;padding:1px 8px;border-radius:999px;font-size:.78rem;border:1px solid var(--line)}
.pill.ok{color:var(--ok);border-color:var(--ok)}.pill.warn{color:var(--warn);border-color:var(--warn)}.pill.bad{color:var(--bad);border-color:var(--bad)}
abbr{text-decoration:underline dotted;cursor:help}
code{background:var(--panel2);padding:1px 5px;border-radius:4px;font-size:.85em}
details{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 12px;margin:8px 0}
summary{cursor:pointer;color:var(--violet);font-weight:600}
footer{margin:32px 0 12px;color:var(--muted);font-size:.8rem;border-top:1px solid var(--line);padding-top:10px}
@media (max-width:640px){body{font-size:14px}h1{font-size:1.3rem}th,td{padding:5px 6px}}
</style>
</head>
<body>
<main>
<header>
  <h1>Xfer Benchmark <span>{{ m.stage }} report</span></h1>
  <div class="muted">Dataset <code>{{ m.dataset_id }}</code> {{ m.dataset_version }} &middot; run <code>{{ m.run_id }}</code> &middot; status
    {% if m.status == 'complete' %}<span class="pill ok">complete</span>{% else %}<span class="pill bad">{{ m.status }}</span>{% endif %}
    &middot; created {{ m.created_at }}</div>
  {% if m.synthetic %}<div class="banner">Synthetic data: these results demonstrate software behavior, not real-world model superiority or production readiness.</div>{% endif %}
  <p class="muted">This report helps select methods for further validation. It does not certify production readiness or guarantee business gains.</p>
</header>

<h2 id="summary">Dataset and scenario summary</h2>
<div class="grid">
  <div class="card"><div class="k"><abbr title="{{ glossary['PAIR0-E'] }}" tabindex="0">PAIR0-E</abbr> launches</div><div class="v">{{ ranked[0].scenarios['PAIR0-E'].n_launches if ranked else (unrankable[0].scenarios['PAIR0-E'].n_launches if unrankable else 0) }}</div></div>
  <div class="card"><div class="k"><abbr title="{{ glossary['PAIR0-N'] }}" tabindex="0">PAIR0-N</abbr> launches</div><div class="v">{{ ranked[0].scenarios['PAIR0-N'].n_launches if ranked else (unrankable[0].scenarios['PAIR0-N'].n_launches if unrankable else 0) }}</div></div>
  <div class="card"><div class="k"><abbr title="{{ glossary['Eligible weeks'] }}" tabindex="0">Eligible weeks</abbr></div><div class="v">{{ m.population.eligible_weeks.get('cold_c0', 0) }}</div></div>
  <div class="card"><div class="k">Unmeasured target weeks</div><div class="v">{{ m.population.unmeasured_target_weeks }}</div></div>
  <div class="card"><div class="k">Origins</div><div class="v">{{ m.origins|length }}</div></div>
  <div class="card"><div class="k">Horizon</div><div class="v">{{ m.horizon_weeks }} weeks</div></div>
</div>
<p class="muted">Fit cutoff {{ m.fit_cutoff }} ({{ m.n_fit_launches }} training launches with labels available by then); selection cutoff {{ m.selection_cutoff }}.
Hashes: data <code>{{ m.dataset_hash|short }}</code> split <code>{{ m.split_hash|short }}</code> population <code>{{ m.population.hashes.get('cold_c0','')|short }}</code>.</p>
{% if stage_profile %}
<details><summary>Observed zero fractions for this stage (outcome diagnostics)</summary>
<div class="tw"><table><thead><tr><th>Board</th><th>Scenario</th><th>Group</th><th class="n">Measured</th><th class="n">Zero weeks</th><th class="n">Zero fraction</th></tr></thead><tbody>
{% for p in stage_profile %}<tr><td>{{ p.board }}</td><td>{{ p.scenario }}</td><td>{{ p.category }}</td><td class="n">{{ p.measured_weeks }}</td><td class="n">{{ p.zero_weeks }}</td><td class="n">{{ p.zero_fraction|pct }}</td></tr>{% endfor %}
</tbody></table></div></details>
{% endif %}

{% if selection %}
<h2 id="selection">Frozen validation selection</h2>
<p>Selection frozen from validation run <code>{{ selection.validation_run_id }}</code> (policy <code>{{ selection.policy_hash|short }}</code>) before the first test origin. Recommended on validation: <code>{{ selection.recommended }}</code>. Test results below do not re-select.</p>
<p class="muted">Frozen variants: {% for v in selection.frozen_variants %}<code>{{ v }}</code> {% endfor %}</p>
{% endif %}

<h2 id="leaderboard">Top eligible methods (cold_c0 board)</h2>
<p class="muted">Ranked by the <abbr title="{{ glossary['Equal-scenario objective'] }}" tabindex="0">equal-scenario objective</abbr>; each scenario is shown separately. <abbr title="{{ glossary['WMAPE'] }}" tabindex="0">WMAPE</abbr>, <abbr title="{{ glossary['Bias'] }}" tabindex="0">Bias</abbr>, <abbr title="{{ glossary['Coverage'] }}" tabindex="0">coverage</abbr>. Units: item units per week.</p>
<div class="tw"><table>
<thead><tr><th>Rank</th><th>Variant</th><th class="n">WMAPE E</th><th class="n">WMAPE N</th><th class="n">Bias E</th><th class="n">Bias N</th><th class="n">Objective</th><th class="n">Coverage E/N</th><th class="n"><abbr title="{{ glossary['Fallback'] }}" tabindex="0">Fallback</abbr> weeks</th><th class="n"><abbr title="Total forecast units on launches whose 52-week actual total is zero (E / N)" tabindex="0">Zero-sale units</abbr> E/N</th></tr></thead>
<tbody>
{% for e in ranked %}{% set E = e.scenarios['PAIR0-E'] %}{% set N = e.scenarios['PAIR0-N'] %}
<tr><td>{{ e.rank.objective }}</td><td><code>{{ e.variant_id }}</code></td><td class="n">{{ E.WMAPE|pct }}</td><td class="n">{{ N.WMAPE|pct }}</td><td class="n">{{ E.Bias|pct }}</td><td class="n">{{ N.Bias|pct }}</td><td class="n">{{ e.objective|pct }}</td><td class="n">{{ E.coverage|pct }} / {{ N.coverage|pct }}</td><td class="n">{{ E.n_fallback + N.n_fallback }}</td><td class="n">{{ E.all_zero_launch_forecast_units|num(1) }} ({{ E.n_all_zero_launches }}) / {{ N.all_zero_launch_forecast_units|num(1) }} ({{ N.n_all_zero_launches }})</td></tr>
{% endfor %}
{% for e in unrankable %}<tr><td>&ndash;</td><td><code>{{ e.variant_id }}</code> <span class="pill bad">unrankable</span></td><td colspan="8">{{ e.objective_reason }}</td></tr>{% endfor %}
</tbody></table></div>
<p><a download="leaderboard.csv" href="{{ lb_uri }}">Export leaderboard (CSV)</a>{% if slices_uri %} &middot; <a download="slices.csv" href="{{ slices_uri }}">Export slices (CSV)</a>{% endif %}</p>

<h2 id="charts">Accuracy and Bias</h2>
<p class="legend"><span><i class="sw" style="background:#a78bfa"></i>PAIR0-E (established FPG)</span><span><i class="sw" style="background:#f472d0"></i>PAIR0-N (new FPG)</span></p>
{{ wmape_chart }}
{{ bias_chart }}

<h2 id="horizon">Horizon slices</h2>
<p class="muted">Solid lines: PAIR0-E; dashed: PAIR0-N.</p>
{{ horizon_chart }}
<details><summary>Horizon slice table</summary>{% set rows = horizon %}{% include "slice_table.html.j2" %}</details>

<h2 id="slices">Category, region, intermittency and availability</h2>
<p class="muted">Best variant per family. Intermittency and availability groups are defined from realized outcomes and are diagnostic only (never used for selection). Sample counts are shown; small groups are noisy.</p>
<details><summary>By category</summary>{% set rows = category %}{% include "slice_table.html.j2" %}</details>
<details><summary>By region</summary>{% set rows = region %}{% include "slice_table.html.j2" %}</details>
<details><summary>By intermittency</summary>{% set rows = intermittency %}{% include "slice_table.html.j2" %}</details>
<details><summary>By availability (stockout weeks vs in stock)</summary>{% set rows = availability %}{% include "slice_table.html.j2" %}</details>

<h2 id="resources">Error versus resource use</h2>
{{ resource_chart }}
<div class="tw"><table><thead><tr><th>Variant</th><th class="n">Fit s</th><th class="n">Predict s</th><th class="n">Peak Python MiB</th><th class="n">Artifact bytes</th><th class="n">Forecast rows</th></tr></thead><tbody>
{% for vid, r in resources.items() %}<tr><td><code>{{ vid }}</code></td><td class="n">{{ r.fit_seconds|num(3) }}</td><td class="n">{{ r.predict_seconds|num(3) }}</td><td class="n">{{ r.peak_python_mib|num(2) }}</td><td class="n">{{ r.artifact_bytes }}</td><td class="n">{{ r.predict_rows }}</td></tr>{% endfor %}
</tbody></table></div>
<p class="muted">{{ process.memory_note }} Process max RSS: {{ process.process_max_rss_mib|num(1) }} MiB; wall time {{ process.wall_seconds|num(2) }} s. Cost: {{ process.cost }}.</p>

<h2 id="excluded">Excluded, blocked and failed methods</h2>
<p class="muted">Every registry entry is accounted for. Registration is not implementation; nothing below received a score.</p>
<div class="tw"><table><thead><tr><th>Method</th><th>Board</th><th>Implementation</th><th>Execution</th><th>Eligibility</th><th>Reason</th><th>Remedy</th></tr></thead><tbody>
{% for s in excluded %}<tr><td><code>{{ s.method_id }}</code><br><span class="muted">{{ s.display_name }}</span></td><td>{{ s.board }}</td><td>{{ s.implementation_state }}</td><td>{{ s.execution_state }}</td><td>{{ s.eligibility_state or '-' }}</td><td class="wide">{{ s.reason }}</td><td class="wide">{{ s.remedy }}</td></tr>{% endfor %}
</tbody></table></div>
<p><a download="method_support.csv" href="{{ support_uri }}">Export method support (CSV)</a></p>

<h2 id="fixtures">Edge fixtures (unranked)</h2>
<p class="muted">Deliberate edge cases kept off the main board: partial launch week, heavy stockouts, missing target weeks, missing propensity, unseen category, unknown location attributes. They show visible failures and fallbacks instead of silent zeros.</p>
{% if fixtures %}
<div class="tw"><table><thead><tr><th>Fixture</th><th>Variant</th><th>Statuses (rows)</th><th>Reasons</th></tr></thead><tbody>
{% for f in fixtures %}<tr><td>{{ f.fixture_kind }}</td><td><code>{{ f.variant_id }}</code></td><td>{% for k, v in f.statuses.items() %}<span class="pill {{ 'ok' if k == 'success' else ('warn' if k == 'fallback' else 'bad') }}">{{ k }}: {{ v }}</span> {% endfor %}</td><td>{% for r in f.reasons %}{{ r }}<br>{% endfor %}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="muted">No edge fixtures in this stage.</p>{% endif %}

<h2 id="failures">Failure and fallback rows</h2>
{% if failures %}
<div class="tw"><table><thead><tr><th>Variant</th><th>Status</th><th>Reason</th><th class="n">Rows</th><th class="n">Requests</th></tr></thead><tbody>
{% for f in failures %}<tr><td><code>{{ f.variant_id }}</code></td><td>{{ f.status }}</td><td>{{ f.reason }}</td><td class="n">{{ f.rows }}</td><td class="n">{{ f.requests }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="muted">No failed or fallback rows.</p>{% endif %}

<h2 id="quality">Data quality</h2>
<p>{{ dq_counts.error }} errors, {{ dq_counts.warning }} warnings, {{ dq_counts.info }} informational notes (details in <code>data_quality.json</code>; raw rows are not displayed).</p>
{% if dq.issues %}<div class="tw"><table><thead><tr><th>Severity</th><th>Code</th><th>Table.column</th><th>Message</th><th class="n">Rows</th></tr></thead><tbody>
{% for i in dq.issues[:30] %}<tr><td>{{ i.severity }}</td><td>{{ i.code }}</td><td>{{ i.table or '' }}{% if i.column %}.{{ i.column }}{% endif %}</td><td>{{ i.message }}</td><td class="n">{{ i.count }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}

<h2 id="definitions">Definitions and limitations</h2>
<ul>{% for k, v in glossary.items() %}<li><strong>{{ k }}</strong>: {{ v }}</li>{% endfor %}</ul>
<ul>{% for l in m.limitations %}<li>{{ l }}</li>{% endfor %}
<li>Ranked rows share dataset, request population, split, origins, horizon, target, aggregation, metrics and information budget (zero own-pair history). Warm-history, donor-only and cold-composite boards are separate.</li>
<li>Literature priorities and published scores are never shown as executed results here.</li>
<li>Point statistic for every ranked recipe: expected units (mean). No quantiles are reported.</li></ul>

<footer>Generated locally by xferbench {{ version }}. No external assets, scripts, tracking or uploads. Software {{ m.software.packages }} on {{ m.hardware.platform }}.</footer>
</main>
</body>
</html>
