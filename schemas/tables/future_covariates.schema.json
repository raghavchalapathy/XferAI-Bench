{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xferbench canonical table: future_covariates",
  "description": "Inputs about future weeks that were genuinely known/planned/issued at origin.",
  "x-primary-key": [
    "feature_name",
    "item_id",
    "fpg_id",
    "scope_id",
    "origin",
    "forecast_week"
